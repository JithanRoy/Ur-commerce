{
  "name": "urcommerce",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "stop": "fuser -k 3100/tcp 5273/tcp 2>/dev/null || true",
    "dev:clean": "pnpm stop && pnpm dev"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.10.12",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
